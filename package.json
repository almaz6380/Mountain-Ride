{
  "name": "mountain-ride",
  "version": "1.0.0",
  "private": true,
  "description": "Mountain Ride – snowboard runner (web game wrapped as an iOS/Android app with Capacitor)",
  "scripts": {
    "build": "python3 tools/build-pages.py --app",
    "sync": "npm run build && npx cap sync",
    "assets": "npx capacitor-assets generate --assetPath resources --iconBackgroundColor '#2b3d63' --splashBackgroundColor '#2b3d63'",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@revenuecat/purchases-capacitor": "^13.7.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
